{
  "manifest_version": 3,
  "name": "Matinee Browser MVP",
  "version": "0.1.0",
  "description": "A paired, fixture-only browser control extension for Matinee.",
  "key": "",
  "permissions": [
    "scripting",
    "activeTab",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html"
}
